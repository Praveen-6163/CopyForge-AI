# CopyForge AI Environment Variables

# Copy this file to an untracked .env and fill values locally or on the backend host.
OPENAI_API_KEY=

# Existing CopyForge backend settings
OPENAI_MODEL=gpt-4o-mini
PORT=8000

# LinkedIn Developer App Client ID (not a password)
LINKEDIN_CLIENT_ID=

# LinkedIn Developer App Client Secret; keep this private on the backend only
LINKEDIN_CLIENT_SECRET=

# Exact OAuth callback URL registered in LinkedIn Developer Portal.
# Local default from backend/app/api/linkedin.py and backend/run.py (PORT=8000):
# http://localhost:8000/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Random server-side session/token-encryption secret (FastAPI backend), at least 32 characters
SECRET_KEY=

# Exact browser origin of the frontend
FRONTEND_ORIGIN=http://localhost:3000
