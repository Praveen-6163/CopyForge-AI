# CopyForge AI Environment Variables

# Copy this file to an untracked .env and fill values locally or on the backend host.
# Google Gemini API Key for server-side AI content and image generation
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
PORT=8000

# Public backend base URL used at frontend build time. Local development default:
VITE_API_BASE_URL=http://localhost:8000

# LinkedIn Developer App Client ID (not a password); backend only
LINKEDIN_CLIENT_ID=

# LinkedIn Developer App Client Secret; backend only, never a VITE_ variable
LINKEDIN_CLIENT_SECRET=

# Exact OAuth callback URL registered in LinkedIn Developer Portal. For Render,
# use https://<your-render-service>.onrender.com/auth/linkedin/callback.
# Local development:
# http://localhost:8000/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Random server-side session/token-encryption secret, at least 32 characters
SECRET_KEY=

# Local SQLite is used if DATABASE_URL is empty. Set DATABASE_URL to the
# Render PostgreSQL internal connection URL in production.
DATABASE_URL=

# Frontend origin for OAuth callback redirects and CORS.
FRONTEND_URL=http://localhost:3000
